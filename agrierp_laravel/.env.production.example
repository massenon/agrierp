# ═══════════════════════════════════════════════════════════════════════════════════════════
#  LogiAgriERP — MODÈLE DE .env POUR LA PRODUCTION
#
#  Copier ce fichier en `.env` SUR LE SERVEUR (jamais dans Git), puis remplacer chaque valeur <…>.
#  Aucun secret ne doit être écrit ici : ce fichier est versionné, le `.env` ne l'est pas.
#
#      cp .env.production.example .env
#      php artisan key:generate        # remplit APP_KEY
#
#  Mise en production : voir docs/INSTALLATION_LOCALE.md et RUNBOOK_DEPLOIEMENT_CPANEL.md.
# ═══════════════════════════════════════════════════════════════════════════════════════════

APP_NAME=LogiAgriERP
APP_ENV=production
APP_KEY=
# JAMAIS true en production : l'application affiche sinon les détails d'erreur aux visiteurs.
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=https://agrierp.fermeolouwachegoun.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Base MySQL / MariaDB (utf8mb4_unicode_ci). Créer la base et un utilisateur dédié, sans droits d'administration.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nom_de_la_base>
DB_USERNAME=<utilisateur_mysql>
DB_PASSWORD=<mot_de_passe_mysql>

# Sessions : SESSION_LIFETIME en minutes (glissante). Cookie réservé à HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# Aucune diffusion temps réel n'est utilisée par l'application.
BROADCAST_CONNECTION=log

# E-mail réel (relances clients, essai SMTP, « Contactez l'Éditeur »). Avec `log`, aucun e-mail ne part.
MAIL_MAILER=smtp
MAIL_HOST=<serveur_smtp>
MAIL_PORT=587
MAIL_USERNAME=<adresse_e-mail>
MAIL_PASSWORD=<mot_de_passe_e-mail>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@fermeolouwachegoun.com"
MAIL_FROM_NAME="${APP_NAME}"

# Module MeCeF (facturation normalisée) : DÉSACTIVÉ jusqu'à sa configuration (décision du client).
# La facturation reste disponible sans lui. Passer à true seulement une fois le module configuré.
MECEF_ACTIF=false

VITE_APP_NAME="${APP_NAME}"

# Après le premier déploiement :
#   composer install --no-dev --optimize-autoloader
#   php artisan migrate --force          # JAMAIS migrate:fresh en production (efface toutes les données)
#   php artisan storage:link
#   npm install && npm run build
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   php artisan agrierp:code-secours     # code de secours de l'administrateur : à imprimer, à ranger au coffre
# Une seule tâche planifiée (cron) par minute : * * * * * cd <chemin>/agrierp_laravel && php artisan schedule:run >> /dev/null 2>&1
